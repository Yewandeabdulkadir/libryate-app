# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard > Project Settings > API). Never commit .env.local.

# Public: safe to expose to the browser. Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The address the app is served from. Used in password reset emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
